{
  "$comment": [
    "autodo-kit 大模型目录（单一真相源）。",
    "",
    "用途：把「本工具可用的模型及其参数、能力、价格」与「调用顺序」外置为数据，",
    "使新增/下架模型、调整路由顺序无需改动 Python 代码。",
    "",
    "字段设计参考 VS Code Copilot 的 chatLanguageModels.json（id/name/url/costLevel/",
    "maxInputTokens/maxOutputTokens/toolCalling/vision），并补充路由所需的字段",
    "（family/task_types/status/replacement/定价明细）。",
    "",
    "修改本文件后无需重启：调用 reload_catalog() 或重新导入模块即可生效。",
    "读取失败时工具会退回内置默认值（不会中断运行），并给出告警。"
  ],
  "schema_version": 1,
  "catalog_version": "2026-09-15",
  "updated_at": "2026-09-15",

  "currencies": {
    "$comment": "定价币种。工具不做汇率换算，跨币种金额不可直接相加。",
    "CNY": "人民币（阿里百炼计费币种）",
    "USD": "美元（DeepSeek 官方计费币种）"
  },

  "regions": {
    "cn-beijing": {
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "default": true
    },
    "ap-southeast-1": {
      "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
    },
    "us-east-1": {
      "base_url": "https://dashscope-us.aliyuncs.com/compatible-mode/v1"
    }
  },

  "providers": [
    {
      "$comment": "priority 越小越优先。auto 路由按 priority 升序逐个尝试（provider 级容灾）。",
      "name": "deepseek",
      "display_name": "DeepSeek 官方",
      "priority": 10,
      "sdk_backend": "openai-compatible",
      "base_url": "https://api.deepseek.com/v1",
      "default_model": "deepseek-flash",
      "fallback_models": ["deepseek-v4-pro"],
      "secret_name": "deepseek",
      "env_api_key_name": "DEEPSEEK_API_KEY",
      "is_local": false,
      "extra_body": {},
      "no_thinking_body": { "thinking": { "type": "disabled" } },
      "notes": "独立账户，与百炼互为平台级容灾。密钥文件：deepseek_api-key_<profile>.txt"
    },
    {
      "name": "bailian",
      "display_name": "阿里百炼",
      "priority": 20,
      "sdk_backend": "openai-compatible",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "default_model": "qwen3.7-plus",
      "fallback_models": [],
      "secret_name": "bailian",
      "env_api_key_name": "DASHSCOPE_API_KEY",
      "is_local": false,
      "extra_body": {},
      "no_thinking_body": { "enable_thinking": false },
      "notes": "内部再叠模型级路由（地域/档位感知 + 跨厂商回退链）。密钥文件：bailian_api-key_<profile>.txt"
    },
    {
      "name": "lmstudio",
      "display_name": "LM Studio 本地",
      "priority": 30,
      "sdk_backend": "openai-compatible",
      "base_url": "http://127.0.0.1:1234/v1",
      "default_model": "qwen/qwen3.5-9b",
      "fallback_models": [],
      "secret_name": "lmstudio",
      "env_api_key_name": "",
      "is_local": true,
      "extra_body": {},
      "no_thinking_body": {},
      "notes": "最后兜底；需本地服务在线。密钥文件：lmstudio_api-key_<profile>.txt"
    }
  ],

  "vendor_rules": [
    { "vendor": "alibaba", "prefixes": ["qwen", "tongyi", "gui-", "wan", "happyhorse"] },
    { "vendor": "deepseek", "prefixes": ["deepseek"] },
    { "vendor": "moonshot", "prefixes": ["kimi", "moonshot"] },
    { "vendor": "zhipu", "prefixes": ["glm", "zhipu", "chatglm"] },
    { "vendor": "minimax", "prefixes": ["minimax"] },
    { "vendor": "xiaomi", "prefixes": ["mimo"] },
    { "vendor": "tripo", "prefixes": ["tripo"] }
